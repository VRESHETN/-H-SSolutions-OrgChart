<mvc:View controllerName="hs.com.orgchart.controller.Orgchart"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f" displayBlock="true">

    <f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="false">

        <f:title>
            <f:DynamicPageTitle id="_IDGenDynamicPageTitle">
                <f:heading>
                    <Title id="_IDGenTitle" text="OrgChart" level="H2"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader id="_IDGenDynamicPageHeader" pinnable="true">
                <HBox id="_IDGenHBox" width="100%" alignItems="End" justifyContent="SpaceBetween">

                    <HBox id="_IDGenHBox1" alignItems="End">
                        <VBox id="_IDGenVBox">
                            <Label id="_IDGenLabel" text="Organisationseinheit"/>
                            <MultiComboBox id="nodeFilter" width="420px" placeholder="Knoten auswählen" selectionFinish="onNodeFilterChange" items="{filterModel>/nodes}">
                                <core:Item id="_IDGenItem" key="{filterModel>id}" text="{filterModel>text}" />
                            </MultiComboBox>
                        </VBox>

                        <VBox id="_IDGenVBox1" class="sapUiSmallMarginBegin">
                            <Label id="_IDGenLabel1" text="Suche"/>
                            <SearchField id="employeeSearch" width="420px" placeholder="Mitarbeiter, Rolle oder Kompetenz suchen" value="{searchModel>/query}" liveChange=".onEmployeeSearch" search=".onEmployeeSearch" />
                        </VBox>
                    </HBox>

                    <HBox id="_IDGenHBox2" alignItems="End">
                        <Button id="_IDGenButton" text="Start" type="Emphasized" press="onApplyFilters" />

                        <Button id="_IDGenButton1" text="Filter zurücksetzen" type="Transparent" press="onClearNodeFilter" class="sapUiTinyMarginBegin" />
                    </HBox>

                </HBox>

                <List id="employeeSearchResults" visible="{searchModel>/visible}" items="{searchModel>/results}" width="420px">

                    <CustomListItem id="_IDGenCustomListItem1" type="Active" press=".onEmployeeSearchResultPress">

                        <HBox id="_IDGenHBox3" alignItems="Center" class="sapUiSmallMargin">
                            <Avatar id="_IDGenAvatar" src="{searchModel>photo_url}" displaySize="S" class="sapUiTinyMarginEnd" />

                            <VBox id="_IDGenVBox2">
                                <Text id="_IDGenText" text="{searchModel>name}" />
                                <Text id="_IDGenText1" text="{searchModel>matched_skill}" />
                            </VBox>
                        </HBox>

                    </CustomListItem>
                </List>

            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox id="_IDGenVBox3" width="100%" height="100%" renderType="Bare">
                <core:HTML id="chartHost"/>
            </VBox>
        </f:content>

    </f:DynamicPage>

</mvc:View>