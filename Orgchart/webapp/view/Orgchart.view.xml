<mvc:View controllerName="hs.com.orgchart.controller.Orgchart"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f" displayBlock="true">

    <f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="false">

        <f:title>
            <f:DynamicPageTitle id="_IDGenDynamicPageTitle">
                <f:heading>
                    <Title id="_IDGenTitle" text="OrgChart" level="H2"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader id="_IDGenDynamicPageHeader" pinnable="true">
                <FlexBox id="headerContentBox" width="100%" direction="Row" wrap="Wrap" alignItems="End" justifyContent="SpaceBetween" class="hsOrgChartHeader">

                    <FlexBox id="filterFieldsBox" direction="Row" wrap="Wrap" alignItems="End" class="hsOrgChartFilterFields">

                        <VBox id="_IDGenVBox" class="hsOrgChartFilterItem">
                            <layoutData>
                                <FlexItemData growFactor="1" shrinkFactor="1" baseSize="420px" />
                            </layoutData>

                            <Label id="_IDGenLabel" text="Organisationseinheit"/>
                            <Input id="nodeFilterDisplay" width="100%" editable="true" enabled="true" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onOpenNodeFilterDialog" placeholder="Knoten auswählen" value="{treeFilterModel>/selectionText}" />
                        </VBox>

                        <VBox id="_IDGenVBox1" class="hsOrgChartFilterItem">
                            <layoutData>
                                <FlexItemData growFactor="1" shrinkFactor="1" baseSize="420px" />
                            </layoutData>

                            <Label id="_IDGenLabel1" text="Suche"/>
                            <Input id="employeeSearch" width="100%" placeholder="Mitarbeiter, Rolle oder Kompetenz suchen" value="{searchModel>/query}" showClearIcon="true" showSuggestion="true" liveChange=".onEmployeeSearchLiveChange" suggest=".onEmployeeSearch" suggestionItemSelected=".onEmployeeSuggestionSelected" suggestionItems="{searchModel>/results}">
                                <suggestionItems>
                                    <core:ListItem key="{searchModel>original_node_id}" text="{searchModel>name}" additionalText="{searchModel>matched_skill}" />
                                </suggestionItems>
                            </Input>
                        </VBox>

                    </FlexBox>

                    <FlexBox id="filterButtonsBox" direction="Row" wrap="Wrap" alignItems="End" justifyContent="End" class="hsOrgChartFilterButtons">

                        <Button id="_IDGenButton" text="Start" type="Emphasized" press="onApplyFilters" />

                        <Button id="_IDGenButton1" text="Filter zurücksetzen" type="Transparent" press="onClearNodeFilter" class="sapUiTinyMarginBegin" />

                    </FlexBox>

                </FlexBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox id="_IDGenVBox3" width="100%" height="100%" renderType="Bare">
                <core:HTML id="chartHost"/>
            </VBox>
        </f:content>

    </f:DynamicPage>

</mvc:View>